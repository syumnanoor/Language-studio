{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "buildCommand":"npm run build",
  "outputDirectory":"dist",
  "functions":{"api/index.js":{"maxDuration":30,"includeFiles":"src/**"}},
  "rewrites":[{"source":"/api/:path*","destination":"/api/index?route=:path*"}],
  "headers":[{"source":"/(.*)","headers":[
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"Referrer-Policy","value":"same-origin"},
    {"key":"X-Frame-Options","value":"DENY"},
    {"key":"Permissions-Policy","value":"camera=(), geolocation=(), microphone=(self)"},
    {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"}
  ]}]
}
